<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ATTENDANCE"
            android:textColor="#009FAF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="16dp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tvAttendanceDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today's Attendance"
            android:textColor="#263746"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tvAttendanceCounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Present: 0 | Late: 0 | Absent: 0"
            android:textColor="#526579"
            android:textSize="15sp"
            android:padding="8dp"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnMarkAllAbsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mark All Absent"
            android:textAllCaps="false"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student List"
            android:textColor="#263746"
            android:textSize="21sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/studentListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:text="Attendance Sumary"
            android:textColor="#263746"
            android:textSize="21sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Attendance History"
            android:textAllCaps="false"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnViewSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Student Summary"
            android:textAllCaps="false"
            tools:ignore="HardcodedText" />

    </LinearLayout>
</ScrollView>
